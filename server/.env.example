# Copy to server/.env and fill in. NEVER commit the real file.
GROQ_API_KEY=
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require
# 32+ random chars: openssl rand -hex 32
IP_HASH_SECRET=
PORT=8787
NODE_ENV=production
# Set to 1 when running behind a reverse proxy / platform load balancer (Render, Railway, Fly, nginx).
TRUST_PROXY=1
# After publishing to the Chrome Web Store, lock the API to your extension ID(s):
# ALLOWED_EXTENSION_IDS=abcdefghijklmnopabcdefghijklmnop

# Optional tuning (defaults shown)
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# HOSTED_TRANSCRIPT_TOKENS=4200      # raise to ~20000 on a paid Groq tier
# DEVICE_DAILY_REQUESTS=30
# GLOBAL_DAILY_TOKENS=5000000        # hard daily spend cap for the hosted AI
# REGISTRATIONS_PER_IP_PER_DAY=10
# REGISTRATIONS_PER_IP_PER_HOUR=5

# Engagement
# ADMIN_TOKEN=                        # 32+ random chars; enables /admin metrics (openssl rand -hex 32)
# REFERRAL_BONUS_DAILY=5
# MAX_REFERRALS_CREDITED=10
# SHARES_PER_DEVICE_PER_DAY=30
